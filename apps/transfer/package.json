{
  "name": "@tzl/transfer",
  "version": "0.1.0",
  "private": true,
  "description": "TianZhiLing data transfer scripts from legacy MySQL to MongoDB.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node ./dist/index.js",
    "dev": "ts-node ./src/index.ts",
    "user": "node ./src/scripts/user/index.js export",
    "user:export": "node ./src/scripts/user/index.js export",
    "agent": "node ./src/scripts/agent.js",
    "agent:export": "node ./src/scripts/agent.js export",
    "agent:import": "node ./src/scripts/agent.js import",
    "conversation": "node ./src/scripts/conversation.js",
    "conversation:export": "node ./src/scripts/conversation.js export",
    "conversation:import": "node ./src/scripts/conversation.js import",
    "message": "node ./src/scripts/message.js",
    "message:export": "node ./src/scripts/message.js export",
    "message:import": "node ./src/scripts/message.js import",
    "post": "node ./src/scripts/post.js",
    "post:export": "node ./src/scripts/post.js export",
    "post:import": "node ./src/scripts/post.js import",
    "post-comment": "node ./src/scripts/post-comment.js",
    "post-comment:export": "node ./src/scripts/post-comment.js export",
    "post-comment:import": "node ./src/scripts/post-comment.js import"
  },
  "dependencies": {
    "@tzl/entities": "workspace:*",
    "mongodb": "^7.1.0",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/node": "14",
    "ts-node": "^10.9.2",
    "typescript": "~4.8.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
