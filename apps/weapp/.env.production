# 生产接口/静态资源域名按品牌注入，见 brand/<brand>.json 的 weapp.* 与 scripts/build-brand.sh weapp。
# 这里显式留空：任何品牌构建都不会误用另一品牌的域名；
# 本地或特殊部署需要覆盖时，在 .env.local 里临时设置即可（不要提交）。
TARO_APP_API_BASE_URL=
TARO_APP_ASSET_BASE_URL=
TARO_APP_MEDIA_BASE_URL=
TARO_APP_POST_NOTIFICATION_V2_API_ENABLED=false


# 本地联调示例（改到 .env.local，不要提交）：
# TARO_APP_API_BASE_URL=http://192.168.19.121:7001
# TARO_APP_ASSET_BASE_URL=http://192.168.19.121:7001
# TARO_APP_MEDIA_BASE_URL=https://oss.tianzhiling.chat


# 开发者工具联调覆盖（仅当 API 地址是本地地址时才生效，同样建议放 .env.local）
# TARO_APP_DEVTOOLS_API_BASE_URL=http://127.0.0.1:7001
