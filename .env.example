# 共享基础设施 / Docker Compose
DOCKER_VOLUME_DIRECTORY=.

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

REDIS_HOST=127.0.0.1
REDIS_PORT=17380
# REDIS_PASSWORD=
REDIS_DB=0

MONGO_HOST=127.0.0.1
MONGO_PORT=17271
MONGO_DB=tzl
MONGO_AUTH_SOURCE=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=replace-with-a-strong-random-password

ETCD_PORT=17239

MINIO_API_PORT=17900
MINIO_CONSOLE_PORT=17902
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-random-password

MILVUS_ADDRESS=127.0.0.1:17953
MILVUS_PORT=17953
MILVUS_HEALTH_PORT=19091
# MILVUS_TOKEN=
# MILVUS_USERNAME=
# MILVUS_PASSWORD=
MILVUS_DATABASE=default

# Node 服务基础 / 启动
NODE_APP_KEYS=replace-with-app-keys
NODE_PORT=7001

# Node JWT 鉴权
NODE_JWT_SECRET=replace-with-jwt-secret
NODE_JWT_EXPIRES_IN_SECONDS=604800

# Admin Node 服务基础 / 启动
ADMIN_API_APP_KEYS=replace-with-admin-app-keys
ADMIN_API_PORT=7101

# Admin Node JWT 鉴权
ADMIN_API_JWT_SECRET=replace-with-admin-jwt-secret
ADMIN_API_JWT_EXPIRES_IN_SECONDS=28800

# Node 短信 / 容联云
NODE_CLOOPEN_SMS_ENABLED=false
# NODE_CLOOPEN_APP_ID=
# NODE_CLOOPEN_ACCOUNT_SID=
# NODE_CLOOPEN_AUTH_TOKEN=
NODE_CLOOPEN_SMS_TEMPLATE_ID=1
NODE_SMS_CODE_EXPIRES_IN_SECONDS=300
NODE_SMS_RESEND_INTERVAL_SECONDS=60

# Node AI / MiniMax
NODE_ENABLED=false
# NODE_API_KEY=
NODE_BASE_URL=https://api.minimax.io/v1
NODE_MODEL=MiniMax-M2.5
# 视觉能力请显式填写专用配置；即使和主模型相同，也不要省略
# NODE_VISION_API_KEY=
# NODE_VISION_BASE_URL=
# NODE_VISION_MODEL=
# 语音转文字请显式填写专用配置；即使和主模型相同，也不要省略
# NODE_SPEECH_TO_TEXT_API_KEY=
# NODE_SPEECH_TO_TEXT_BASE_URL=
# NODE_SPEECH_TO_TEXT_MODEL=
# 语音合成请显式填写专用配置；即使和主模型相同，也不要省略
# NODE_TEXT_TO_SPEECH_API_KEY=
# NODE_TEXT_TO_SPEECH_BASE_URL=
NODE_TEXT_TO_SPEECH_MODEL=qwen3-tts-vc-2026-01-22
# qwen3-tts-vc-2026-01-22 需要填写已复刻完成的音色名称
# NODE_TEXT_TO_SPEECH_VOICE=
NODE_TEXT_TO_SPEECH_LANGUAGE_TYPE=Chinese
NODE_TEMPERATURE=1
NODE_TOP_P=0.95
NODE_PRESENCE_PENALTY=0.6
NODE_FREQUENCY_PENALTY=0.3
NODE_MAX_RETRIES=2
NODE_TIMEOUT_MS=120000
NODE_REASONING_SPLIT=true

# 主模型聊天工具：先影子抽样观察；active 需通过质量和成本门槛后再开启。
NODE_CHAT_TOOLS_MODE=shadow
NODE_CHAT_TOOLS_SHADOW_SAMPLE_RATE=0.2
NODE_CHAT_TOOLS_ACTIVE_SAMPLE_RATE=0
NODE_CHAT_TOOLS_MAX_CALLS_PER_TURN=4
NODE_CHAT_TOOLS_TIMEOUT_MS=2500
# Node 向量 Embedding
# Embedding 请显式填写专用配置；不再回退到其它变量名
# NODE_EMBEDDING_API_KEY=
# NODE_EMBEDDING_BASE_URL=
# NODE_EMBEDDING_MODEL=
# NODE_EMBEDDING_DIMENSIONS=

# Node Milvus
NODE_MILVUS_ENABLED=false
NODE_MILVUS_COLLECTION_NAME=conversation_message_memory
NODE_MILVUS_MAX_TEXT_LENGTH=4096
NODE_MILVUS_TOP_K=6
NODE_MILVUS_SEARCH_EF=64
# NODE_MILVUS_MIN_SCORE=
NODE_MILVUS_TIMEOUT_MS=10000



NODE_BULLMQ_PREFIX={tzl-bullmq}
NODE_BULLMQ_REMOVE_ON_COMPLETE=100
NODE_BULLMQ_REMOVE_ON_FAIL=500

# Node 阿里云 OSS
NODE_OSS_ENABLED=false
# NODE_OSS_REGION=
# NODE_OSS_BUCKET=
# NODE_OSS_ENDPOINT=
# NODE_OSS_PUBLIC_BASE_URL=
# NODE_OSS_ACCESS_KEY_ID=
# NODE_OSS_ACCESS_KEY_SECRET=
# NODE_OSS_STS_TOKEN=
NODE_OSS_SECURE=true
NODE_OSS_TIMEOUT_MS=60000
NODE_OSS_UPLOAD_PREFIX=static
NODE_OSS_SIGNED_URL_EXPIRE_SECONDS=900

# Node 腾讯云 COS
NODE_TENCENT_COS_ENABLED=false
# NODE_TENCENT_COS_REGION=
# NODE_TENCENT_COS_BUCKET=
# NODE_TENCENT_COS_SECRET_ID=
# NODE_TENCENT_COS_SECRET_KEY=
# NODE_TENCENT_COS_SECURITY_TOKEN=
NODE_TENCENT_COS_PROTOCOL=https:
# NODE_TENCENT_COS_DOMAIN=
# NODE_TENCENT_COS_PUBLIC_BASE_URL=

# Taro weapp/h5 runtime base urls
# TARO_APP_API_BASE_URL=https://api.example.com
# TARO_APP_ASSET_BASE_URL=https://api.example.com
NODE_TENCENT_COS_UPLOAD_PREFIX=static
NODE_TENCENT_COS_SIGNED_URL_EXPIRE_SECONDS=900

# Node 声音素材后台剪辑；Docker 镜像已安装 ffmpeg
NODE_FFMPEG_BINARY_PATH=ffmpeg
NODE_FFMPEG_TIMEOUT_MS=300000
NODE_VOICE_CLIP_SEGMENT_SECONDS=12
NODE_VOICE_CLIP_MAX_PER_MATERIAL=8
NODE_VOICE_CLIP_MAX_TOTAL=8
NODE_VOICE_CLIP_MAX_SOURCE_SECONDS=180
NODE_VOICE_CLIP_MIN_BYTES=4096
NODE_VOICE_CLIP_MIN_USABLE_SECONDS=2
NODE_VOICE_CLIP_MAX_SILENCE_RATIO=0.75
NODE_VOICE_CLIP_MAX_CLIPPING_RATIO=0.12
NODE_VOICE_CLIP_MIN_RECOVERABLE_RMS_DB=-58
NODE_VOICE_CLIP_LOW_VOLUME_RMS_DB=-32
NODE_VOICE_CLIP_TARGET_RMS_DB=-22
NODE_VOICE_CLIP_MAX_VOLUME_GAIN_DB=20
NODE_VOICE_CLIP_MIN_SIGNAL_TO_NOISE_DB=4
NODE_VOICE_CLIP_WARNING_SIGNAL_TO_NOISE_DB=12

# 百炼语音分析：说话人分离、句子时间戳
NODE_VOICE_ANALYSIS_ENABLED=true
# NODE_VOICE_ANALYSIS_API_KEY=（默认复用 DASHSCOPE_API_KEY）
NODE_VOICE_ANALYSIS_BASE_URL=https://dashscope.aliyuncs.com
NODE_VOICE_ANALYSIS_MODEL=paraformer-v2
NODE_VOICE_ANALYSIS_TIMEOUT_MS=240000
NODE_VOICE_ANALYSIS_POLL_INTERVAL_MS=2000

# Admin Node MiniMax 音色复刻
ADMIN_API_MINIMAX_VOICE_ENABLED=true
# ADMIN_API_MINIMAX_VOICE_API_KEY=
ADMIN_API_MINIMAX_VOICE_BASE_URL=https://api.minimax.io
ADMIN_API_MINIMAX_VOICE_PREVIEW_MODEL=speech-2.8-turbo
ADMIN_API_MINIMAX_VOICE_TIMEOUT_MS=120000

# Admin Node mp4 抽音频；Docker 镜像已安装 ffmpeg，通常无需修改路径
ADMIN_API_FFMPEG_BINARY_PATH=ffmpeg
ADMIN_API_FFMPEG_TIMEOUT_MS=120000

# Node 微信小程序登录
# NODE_WECHAT_MINI_PROGRAM_APP_ID=
# NODE_WECHAT_MINI_PROGRAM_APP_SECRET=

# Node 微信支付
NODE_WECHAT_PAY_ENABLED=false
# NODE_WECHAT_PAY_APP_ID=
# NODE_WECHAT_PAY_APP_SECRET=
# NODE_WECHAT_PAY_MCH_ID=
# NODE_WECHAT_PAY_MCH_SERIAL_NO=
# NODE_WECHAT_PAY_PRIVATE_KEY_PATH=resource/cert/apiclient_key.pem
# NODE_WECHAT_PAY_PUBLIC_KEY_ID=
# NODE_WECHAT_PAY_PUBLIC_KEY_PATH=resource/cert/pub_key.pem
# NODE_WECHAT_PAY_API_V3_KEY=
# NODE_WECHAT_PAY_NOTIFY_URL=https://example.com/api/pay/wechat/notify

# Node 微信虚拟支付
NODE_WECHAT_VIRTUAL_PAY_ENABLED=false
# NODE_WECHAT_VIRTUAL_PAY_OFFER_ID=
# NODE_WECHAT_VIRTUAL_PAY_ENV=1
# NODE_WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=
# NODE_WECHAT_VIRTUAL_PAY_PRODUCTION_APP_KEY=

# Node 数据库运行行为
NODE_DB_SYNCHRONIZE=true
NODE_DB_LOGGING=false

# Admin Node 数据库运行行为
ADMIN_API_DB_SYNCHRONIZE=false
ADMIN_API_DB_LOGGING=false
